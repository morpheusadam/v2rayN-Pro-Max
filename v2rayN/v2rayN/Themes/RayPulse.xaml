<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:v2rayN.Converters"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!--
        RayPulse design system.

        Almost every view in this app routes its look through a handful of shared style
        keys (DefButton, DefDataGrid, ToolbarMenu, WindowGlobal, ...). Redefining those
        keys here restyles the whole application without editing the view files, which
        keeps the diff against upstream v2rayN small and the next merge cheap.

        Colour tokens live in Palette.Light.xaml / Palette.Dark.xaml and are referenced
        with DynamicResource so switching theme repaints without a restart.
    -->

    <!--  ============================  Geometry  ============================  -->
    <!--  8px base grid, radii from the spec's scale.  -->

    <system:Double x:Key="RayPulse.Radius.Card">14</system:Double>
    <system:Double x:Key="RayPulse.Radius.Small">10</system:Double>
    <system:Double x:Key="RayPulse.Radius.Pill">999</system:Double>

    <CornerRadius x:Key="RayPulse.CornerRadius.Card">14</CornerRadius>
    <CornerRadius x:Key="RayPulse.CornerRadius.Small">10</CornerRadius>
    <CornerRadius x:Key="RayPulse.CornerRadius.Chip">8</CornerRadius>
    <CornerRadius x:Key="RayPulse.CornerRadius.Pill">999</CornerRadius>

    <Thickness x:Key="RayPulse.Pad.Card">20</Thickness>
    <Thickness x:Key="RayPulse.Pad.Control">14,9</Thickness>
    <Thickness x:Key="RayPulse.Pad.Chip">10,3</Thickness>
    <Thickness x:Key="RayPulse.Gap.Row">0,0,0,8</Thickness>

    <!--  ==========================  Typography  ===========================  -->
    <!--
        The spec calls for a rounded geometric sans. Quicksand ships with the app
        (Resources/Fonts, OFL licensed); Segoe UI and Microsoft YaHei follow it in the
        fallback chain so Persian, CJK and emoji in server names still render.
    -->

    <FontFamily x:Key="RayPulse.Font">
        pack://application:,,,/Resources/Fonts/#Quicksand, Segoe UI, Microsoft YaHei
    </FontFamily>

    <system:Double x:Key="RayPulse.Size.Display">30</system:Double>
    <system:Double x:Key="RayPulse.Size.Metric">22</system:Double>
    <system:Double x:Key="RayPulse.Size.Section">16</system:Double>
    <system:Double x:Key="RayPulse.Size.Caption">11</system:Double>

    <Style x:Key="RayPulse.Text.Display" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource RayPulse.Font}" />
        <Setter Property="FontSize" Value="{DynamicResource RayPulse.Size.Display}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource RayPulse.Brush.TextPrimary}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="RayPulse.Text.Metric" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource RayPulse.Font}" />
        <Setter Property="FontSize" Value="{DynamicResource RayPulse.Size.Metric}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource RayPulse.Brush.TextPrimary}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="RayPulse.Text.Section" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource RayPulse.Font}" />
        <Setter Property="FontSize" Value="{DynamicResource RayPulse.Size.Section}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource RayPulse.Brush.TextPrimary}" />
    </Style>

    <Style x:Key="RayPulse.Text.Caption" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource RayPulse.Font}" />
        <Setter Property="FontSize" Value="{DynamicResource RayPulse.Size.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource RayPulse.Brush.TextSecondary}" />
    </Style>

    <!--  ============================  Elevation  ===========================  -->
    <!--  Cards read as raised paper, not floating panels.  -->

    <DropShadowEffect
        x:Key="RayPulse.Shadow.Card"
        BlurRadius="14"
        Direction="270"
        Opacity="0.10"
        ShadowDepth="3"
        Color="#000000" />

    <DropShadowEffect
        x:Key="RayPulse.Shadow.Accent"
        BlurRadius="16"
        Direction="270"
        Opacity="0.35"
        ShadowDepth="3"
        Color="#F15A2B" />

    <!--  ==============================  Cards  =============================  -->

    <Style x:Key="RayPulse.Card" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource RayPulse.Brush.Card}" />
        <Setter Property="CornerRadius" Value="{StaticResource RayPulse.CornerRadius.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource RayPulse.Brush.Hairline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{StaticResource RayPulse.Pad.Card}" />
    </Style>

    <Style
        x:Key="RayPulse.Card.Muted"
        BasedOn="{StaticResource RayPulse.Card}"
        TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource RayPulse.Brush.CardMuted}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!--  ============================  Buttons  =============================  -->
    <!--
        Pill shaped, flat, no MaterialDesign ripple shadow. The accent variant is the
        only filled-orange control in the app, matching the spec's rule that orange
        marks the primary action and nothing else.
    -->

    <Style x:Key="RayPulse.Button.Base" TargetType="{x:Type ButtonBase}">
        <Setter Property="FontFamily" Value="{DynamicResource RayPulse.Font}" />
        <Setter Property="FontSize" Value="{DynamicResource StdFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="{StaticResource RayPulse.Pad.Control}" />
        <Setter Property="Foreground" Value="{DynamicResource RayPulse.Brush.TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource RayPulse.Brush.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource RayPulse.Brush.Hairline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ButtonBase}">
                    <Border
                        x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{StaticResource RayPulse.CornerRadius.Pill}">
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.70" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.40" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="RayPulse.Button.Accent"
        BasedOn="{StaticResource RayPulse.Button.Base}"
        TargetType="{x:Type ButtonBase}">
        <Setter Property="Background" Value="{DynamicResource RayPulse.Brush.AccentGradient}" />
        <Setter Property="Foreground" Value="{DynamicResource RayPulse.Brush.TextOnAccent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Effect" Value="{StaticResource RayPulse.Shadow.Accent}" />
    </Style>

    <Style
        x:Key="RayPulse.Button.Ghost"
        BasedOn="{StaticResource RayPulse.Button.Base}"
        TargetType="{x:Type ButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource RayPulse.Brush.TextSecondary}" />
    </Style>

    <!--  Circular icon button — the spec's quick-action shape.  -->
    <Style
        x:Key="RayPulse.Button.Icon"
        BasedOn="{StaticResource RayPulse.Button.Base}"
        TargetType="{x:Type ButtonBase}">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource RayPulse.Brush.TextSecondary}" />
    </Style>

    <!--  =============================  Chips  ==============================  -->

    <Style x:Key="RayPulse.Chip" TargetType="{x:Type Border}">
        <Setter Property="CornerRadius" Value="{StaticResource RayPulse.CornerRadius.Chip}" />
        <Setter Property="Padding" Value="{StaticResource RayPulse.Pad.Chip}" />
        <Setter Property="Background" Value="{DynamicResource RayPulse.Brush.CardMuted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  =====================  Overrides of shared keys  ====================  -->
    <!--
        Everything below re-points a key the existing views already use, so the whole
        app picks up the system without any view being edited.
    -->

    <Style
        x:Key="DefButton"
        BasedOn="{StaticResource RayPulse.Button.Base}"
        TargetType="{x:Type ButtonBase}" />

    <Style x:Key="ToolbarTextBlock" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource RayPulse.Font}" />
        <Setter Property="FontSize" Value="{DynamicResource StdFontSize}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource RayPulse.Brush.TextPrimary}" />
    </Style>

    <Style x:Key="ModuleTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource RayPulse.Font}" />
        <Setter Property="FontSize" Value="{DynamicResource StdFontSize1}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource RayPulse.Brush.TextPrimary}" />
    </Style>

    <Style x:Key="StatusbarItem" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource RayPulse.Font}" />
        <Setter Property="FontSize" Value="{DynamicResource StdFontSize}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource RayPulse.Brush.TextSecondary}" />
    </Style>

    <Style x:Key="ListItemTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource RayPulse.Font}" />
        <Setter Property="FontSize" Value="{DynamicResource StdFontSize}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource RayPulse.Brush.TextPrimary}" />
    </Style>

    <Style x:Key="ListItemSubTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource RayPulse.Font}" />
        <Setter Property="FontSize" Value="{DynamicResource StdFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource RayPulse.Brush.TextSecondary}" />
    </Style>

    <Style x:Key="ListItemSubTitle2" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource RayPulse.Font}" />
        <Setter Property="FontSize" Value="{DynamicResource StdFontSize-1}" />
        <Setter Property="Foreground" Value="{DynamicResource RayPulse.Brush.TextSecondary}" />
    </Style>

    <!--  Airier rows, hairline separators, accent-tinted selection.  -->
    <Style
        x:Key="DefDataGrid"
        BasedOn="{StaticResource MaterialDesignDataGrid}"
        TargetType="{x:Type DataGrid}">
        <Setter Property="FontFamily" Value="{DynamicResource RayPulse.Font}" />
        <Setter Property="FontSize" Value="{DynamicResource StdFontSize}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RowHeight" Value="34" />
        <Setter Property="ColumnHeaderHeight" Value="34" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource RayPulse.Brush.Hairline}" />
        <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="AlternatingRowBackground" Value="Transparent" />
        <Setter Property="materialDesign:DataGridAssist.CellPadding" Value="10,0" />
        <Setter Property="materialDesign:DataGridAssist.ColumnHeaderPadding" Value="10,0" />
        <Setter Property="ColumnHeaderStyle">
            <Setter.Value>
                <Style BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}" TargetType="{x:Type DataGridColumnHeader}">
                    <Setter Property="FontFamily" Value="{DynamicResource RayPulse.Font}" />
                    <Setter Property="FontSize" Value="{DynamicResource StdFontSize-1}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Foreground" Value="{DynamicResource RayPulse.Brush.TextSecondary}" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                    <Setter Property="BorderBrush" Value="{DynamicResource RayPulse.Brush.Hairline}" />
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="RowStyle">
            <Setter.Value>
                <Style TargetType="{x:Type DataGridRow}">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{DynamicResource RayPulse.Brush.TextPrimary}" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource RayPulse.Brush.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource RayPulse.Brush.SelectionRow}" />
                            <Setter Property="Foreground" Value="{DynamicResource RayPulse.Brush.TextPrimary}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="DefTextBox"
        BasedOn="{StaticResource MaterialDesignTextBox}"
        TargetType="{x:Type TextBox}">
        <Setter Property="FontFamily" Value="{DynamicResource RayPulse.Font}" />
        <Setter Property="FontSize" Value="{DynamicResource StdFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource RayPulse.Brush.TextPrimary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource RayPulse.Brush.Accent}" />
    </Style>

    <Style
        x:Key="MyOutlinedTextBox"
        BasedOn="{StaticResource MaterialDesignOutlinedTextBox}"
        TargetType="{x:Type TextBox}">
        <Setter Property="FontFamily" Value="{DynamicResource RayPulse.Font}" />
        <Setter Property="FontSize" Value="{DynamicResource StdFontSize}" />
        <Setter Property="Padding" Value="{StaticResource OutlinedTextBoxDefaultPadding}" />
        <Setter Property="CaretBrush" Value="{DynamicResource RayPulse.Brush.Accent}" />
        <Setter Property="materialDesign:TextFieldAssist.TextBoxViewMargin" Value="1,0,1,0" />
    </Style>

    <Style
        x:Key="DefComboBox"
        BasedOn="{StaticResource MaterialDesignComboBox}"
        TargetType="{x:Type ComboBox}">
        <Setter Property="FontFamily" Value="{DynamicResource RayPulse.Font}" />
        <Setter Property="FontSize" Value="{DynamicResource StdFontSize}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style
        x:Key="MyOutlinedTextComboBox"
        BasedOn="{StaticResource MaterialDesignOutlinedComboBox}"
        TargetType="{x:Type ComboBox}">
        <Setter Property="FontFamily" Value="{DynamicResource RayPulse.Font}" />
        <Setter Property="FontSize" Value="{DynamicResource StdFontSize}" />
        <Setter Property="Padding" Value="{StaticResource OutlinedTextBoxDefaultPadding}" />
    </Style>

    <Style
        x:Key="DefContextMenu"
        BasedOn="{StaticResource MaterialDesignContextMenu}"
        TargetType="{x:Type ContextMenu}">
        <Setter Property="FontFamily" Value="{DynamicResource RayPulse.Font}" />
        <Setter Property="FontSize" Value="{DynamicResource StdFontSize}" />
    </Style>

    <Style
        x:Key="ToolbarMenu"
        BasedOn="{StaticResource MaterialDesignMenu}"
        TargetType="{x:Type Menu}">
        <Setter Property="FontFamily" Value="{DynamicResource RayPulse.Font}" />
        <Setter Property="FontSize" Value="{DynamicResource StdFontSize}" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style
        x:Key="MyGroupBox"
        BasedOn="{StaticResource MaterialDesignGroupBox}"
        TargetType="{x:Type GroupBox}">
        <Setter Property="FontFamily" Value="{DynamicResource RayPulse.Font}" />
        <Setter Property="FontSize" Value="{DynamicResource StdFontSize}" />
        <Setter Property="materialDesign:ColorZoneAssist.Background" Value="{DynamicResource RayPulse.Brush.CardMuted}" />
        <Setter Property="materialDesign:ColorZoneAssist.Foreground" Value="{DynamicResource RayPulse.Brush.TextPrimary}" />
    </Style>

    <Style
        x:Key="ListItemCheckBox"
        BasedOn="{StaticResource MaterialDesignUserForegroundCheckBox}"
        TargetType="{x:Type CheckBox}">
        <Setter Property="FontFamily" Value="{DynamicResource RayPulse.Font}" />
        <Setter Property="FontSize" Value="{DynamicResource StdFontSize}" />
    </Style>

    <Style x:Key="GridViewColumnHeaderStyle" TargetType="{x:Type GridViewColumnHeader}">
        <Setter Property="Height" Value="34" />
        <Setter Property="FontFamily" Value="{DynamicResource RayPulse.Font}" />
    </Style>

    <Style x:Key="WindowGlobal" TargetType="{x:Type Window}">
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource RayPulse.Brush.TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource RayPulse.Brush.Background}" />
        <Setter Property="TextElement.FontFamily" Value="{DynamicResource RayPulse.Font}" />
        <Setter Property="FontFamily" Value="{DynamicResource RayPulse.Font}" />
        <Setter Property="ResizeMode" Value="CanResize" />
    </Style>

    <Style x:Key="ViewGlobal" TargetType="{x:Type UserControl}">
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource RayPulse.Brush.TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource RayPulse.Brush.Background}" />
        <Setter Property="TextElement.FontFamily" Value="{DynamicResource RayPulse.Font}" />
        <Setter Property="FontFamily" Value="{DynamicResource RayPulse.Font}" />
    </Style>

</ResourceDictionary>
