<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Dark counterpart of Palette.Light.xaml — same keys, same geometry, same accent.
        The spec is a light design but already contains dark surfaces (#28282B sidebar,
        #242426 card), so the dark theme promotes those to backgrounds rather than
        inventing a second colour language.
    -->

    <Color x:Key="RayPulse.Color.Accent">#F15A2B</Color>
    <Color x:Key="RayPulse.Color.AccentLight">#FF7A45</Color>

    <!--  Surfaces  -->
    <SolidColorBrush x:Key="RayPulse.Brush.Background" Color="#161618" />
    <SolidColorBrush x:Key="RayPulse.Brush.Card" Color="#242426" />
    <SolidColorBrush x:Key="RayPulse.Brush.CardMuted" Color="#2E2E32" />
    <SolidColorBrush x:Key="RayPulse.Brush.CardDark" Color="#101012" />
    <SolidColorBrush x:Key="RayPulse.Brush.Sidebar" Color="#0F0F11" />

    <!--  Text  -->
    <SolidColorBrush x:Key="RayPulse.Brush.TextPrimary" Color="#F3F3F1" />
    <SolidColorBrush x:Key="RayPulse.Brush.TextSecondary" Color="#8C8C92" />
    <SolidColorBrush x:Key="RayPulse.Brush.TextOnDark" Color="#FFFFFF" />
    <SolidColorBrush x:Key="RayPulse.Brush.TextOnAccent" Color="#FFFFFF" />

    <!--  Lines and fills  -->
    <SolidColorBrush x:Key="RayPulse.Brush.Hairline" Color="#33333A" />
    <SolidColorBrush x:Key="RayPulse.Brush.Track" Color="#3A3A41" />
    <SolidColorBrush x:Key="RayPulse.Brush.Hover" Color="#FFFFFF14" />
    <SolidColorBrush x:Key="RayPulse.Brush.SelectionRow" Color="#F15A2B" Opacity="0.18" />

    <!--  Accent  -->
    <SolidColorBrush x:Key="RayPulse.Brush.Accent" Color="#F15A2B" />
    <SolidColorBrush x:Key="RayPulse.Brush.AccentSoft" Color="#F15A2B" Opacity="0.20" />

    <LinearGradientBrush x:Key="RayPulse.Brush.AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#F15A2B" />
        <GradientStop Offset="1" Color="#FF7A45" />
    </LinearGradientBrush>

    <!--  Lifted slightly so they stay legible against dark surfaces.  -->
    <SolidColorBrush x:Key="RayPulse.Brush.Good" Color="#41C289" />
    <SolidColorBrush x:Key="RayPulse.Brush.Fair" Color="#E0B44A" />
    <SolidColorBrush x:Key="RayPulse.Brush.Poor" Color="#E8705C" />

</ResourceDictionary>
