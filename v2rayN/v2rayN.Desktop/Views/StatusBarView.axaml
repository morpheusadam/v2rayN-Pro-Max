<UserControl
    x:Class="v2rayN.Desktop.Views.StatusBarView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="clr-namespace:v2rayN.Desktop.DesignData"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    x:DataType="vms:StatusBarViewModel"
    Design.DataContext="{x:Static dd:DesignData.StatusBar}"
    mc:Ignorable="d">

    <!--
        The status bar answers three separate questions, so it is grouped that way rather
        than laid out as one row of unlabelled controls: what am I connected through, what
        are the switches, and what is actually flowing. Every control keeps its original
        x:Name because the view model binds to them by name.
    -->
    <Border
        Margin="8,0,8,8"
        Padding="14,10"
        Background="{DynamicResource RayPulse.Card}"
        BorderBrush="{DynamicResource RayPulse.Hairline}"
        BorderThickness="1"
        CornerRadius="{DynamicResource RayPulse.RadiusCard}">

        <Grid ColumnDefinitions="*,Auto,Auto">

            <!--
                Active connection. A Grid rather than a horizontal StackPanel: a stack
                hands its children unlimited width, so TextTrimming never engages and a
                long server name simply runs across the controls beside it.
            -->
            <Grid Grid.Column="0" ColumnDefinitions="Auto,*">
                <Ellipse
                    Grid.Column="0"
                    Width="9"
                    Height="9"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    Fill="{DynamicResource RayPulse.Accent}" />
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="1">
                    <TextBlock
                        x:Name="txtRunningServerDisplay"
                        Cursor="Hand"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource RayPulse.TextPrimary}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip.Tip="Click to select this server in the list" />
                    <TextBlock
                        x:Name="txtRunningInfoDisplay"
                        Classes="RayPulseCaption"
                        Cursor="Hand"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <!--
                Switches on one line with the label beside the control. A status bar is a
                short strip, and stacking a caption above each control pushed the row
                taller than the space available, so the labels collided with them.
            -->
            <StackPanel
                Grid.Column="1"
                Margin="16,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="16">

                <StackPanel
                    x:Name="spEnableTun"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <TextBlock
                        VerticalAlignment="Center"
                        Classes="RayPulseCaption"
                        Text="{x:Static resx:ResUI.TbEnableTunAs}" />
                    <ToggleSwitch
                        x:Name="togEnableTun"
                        VerticalAlignment="Center"
                        OffContent=""
                        OnContent="" />
                </StackPanel>

                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <TextBlock
                        VerticalAlignment="Center"
                        Classes="RayPulseCaption"
                        Text="{x:Static resx:ResUI.menuSystemproxy}" />
                    <ComboBox
                        x:Name="cmbSystemProxy"
                        Width="180"
                        VerticalAlignment="Center"
                        ToolTip.Tip="{x:Static resx:ResUI.menuSystemproxy}">
                        <ComboBoxItem Content="{x:Static resx:ResUI.menuSystemProxyClear}" />
                        <ComboBoxItem Content="{x:Static resx:ResUI.menuSystemProxySet}" />
                        <ComboBoxItem Content="{x:Static resx:ResUI.menuSystemProxyNothing}" />
                        <ComboBoxItem Content="{x:Static resx:ResUI.menuSystemProxyPac}" />
                    </ComboBox>
                </StackPanel>

                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <TextBlock
                        VerticalAlignment="Center"
                        Classes="RayPulseCaption"
                        Text="{x:Static resx:ResUI.menuRouting}" />
                    <ComboBox
                        x:Name="cmbRoutings2"
                        Width="180"
                        VerticalAlignment="Center"
                        DisplayMemberBinding="{Binding Remarks}"
                        ItemsSource="{Binding RoutingItems}"
                        ToolTip.Tip="{x:Static resx:ResUI.menuRouting}" />
                </StackPanel>
            </StackPanel>

            <!--  Live traffic, and the local addresses it is served on  -->
            <Border
                Grid.Column="2"
                Padding="12,7"
                Background="{DynamicResource RayPulse.CardMuted}"
                CornerRadius="{DynamicResource RayPulse.RadiusSmall}">
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="10"
                                Foreground="{DynamicResource RayPulse.Accent}"
                                Text="▲"
                                ToolTip.Tip="Through the proxy" />
                            <TextBlock
                                x:Name="txtSpeedProxyDisplay"
                                MinWidth="118"
                                FontFamily="{DynamicResource RayPulse.Mono}"
                                FontSize="11" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="10"
                                Foreground="{DynamicResource RayPulse.TextSecondary}"
                                Text="▼"
                                ToolTip.Tip="Direct, bypassing the proxy" />
                            <TextBlock
                                x:Name="txtSpeedDirectDisplay"
                                MinWidth="118"
                                FontFamily="{DynamicResource RayPulse.Mono}"
                                FontSize="11"
                                Foreground="{DynamicResource RayPulse.TextSecondary}" />
                        </StackPanel>
                    </StackPanel>

                    <Rectangle
                        Width="1"
                        Margin="0,2"
                        Fill="{DynamicResource RayPulse.Hairline}" />

                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock
                            x:Name="txtInboundDisplay"
                            FontFamily="{DynamicResource RayPulse.Mono}"
                            FontSize="11"
                            Foreground="{DynamicResource RayPulse.TextSecondary}"
                            ToolTip.Tip="Local address apps on this machine should point at" />
                        <TextBlock
                            x:Name="txtInboundLanDisplay"
                            FontFamily="{DynamicResource RayPulse.Mono}"
                            FontSize="11"
                            Foreground="{DynamicResource RayPulse.TextSecondary}"
                            ToolTip.Tip="Address other devices on your network can use" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
